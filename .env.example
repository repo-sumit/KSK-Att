# KSK Attendance — no secrets are needed for the demo build.
# true  → floating demo panel, presets, simulations (demo code is bundled)
# false → demo code is compiled out; mock data with real browser location/connectivity
NEXT_PUBLIC_DEMO_MODE=true

# Voice mode (Gemini Live) is the one feature that needs a secret. The variables below are read on the server
# only, by the token route (src/app/api/voice/token/route.ts), when a request arrives. Without a key the route
# answers 503: voice mode says it is unavailable and the tap flow keeps working.
# Put real values in .env.development / .env.production (both git-ignored) or in the Vercel project settings,
# never in a committed file.

# GEMINI_API_KEY: the Gemini Developer API key. Never give it a NEXT_PUBLIC_ name: that would ship it to every browser.
# GEMINI_API_KEY=

# VOICE_DISABLED: set to exactly 1 to switch voice off everywhere at once (the token route answers 503).
# VOICE_DISABLED=

# Extra origins (comma-separated) the voice token route accepts besides its own host, for example a preview domain of the same deployment. The route sends no CORS headers, so this does not let another website call it from a browser.
# VOICE_ALLOWED_ORIGINS=
